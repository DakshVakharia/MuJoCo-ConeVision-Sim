<?xml version="1.0"?>
<package format="2">
  <name>fs_mono_cam_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo simulator of a Formula Student car with a single long-range monocular camera: random cone tracks, RGB feed and ground-truth "YOLO-style" bounding boxes over ROS.</description>
  <maintainer email="daksh.vakharia@gmail.com">Daksh Vakharia</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- C++ runtime node (cpp/ros/sim_node.cpp). MuJoCo itself is not a rosdep key: set MUJOCO_DIR. -->
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>image_transport</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>foxglove_msgs</depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <build_depend>yaml-cpp</build_depend>
  <exec_depend>yaml-cpp</exec_depend>
  <!-- EGL headers/libs for the headless renderer (rosdep key `libegl1-mesa-dev`, Ubuntu 20.04;
       libglvnd-dev also works). The NVIDIA runtime EGL comes from the driver (libnvidia-gl-XXX). -->
  <build_depend>libegl1-mesa-dev</build_depend>
  <build_depend>libgl1-mesa-dev</build_depend>

  <!-- Python offline tooling / python node -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
</package>
